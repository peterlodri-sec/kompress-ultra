{
  "name": "kompress-ultra",
  "version": "11.0.0",
  "description": "4-role living context layer for AI agent frameworks. Pluggable token estimation, instance-isolated state, auth-protected API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./scoring": {
      "import": "./dist/scoring.js",
      "types": "./dist/scoring.d.ts"
    },
    "./circuit-breaker": {
      "import": "./dist/circuit-breaker.js",
      "types": "./dist/circuit-breaker.d.ts"
    },
    "./circulator": {
      "import": "./dist/circulator.js",
      "types": "./dist/circulator.d.ts"
    },
    "./errors": {
      "import": "./dist/errors.js",
      "types": "./dist/errors.d.ts"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "registry": "verdaccio -c verdaccio/config.yaml",
    "publish:local": "npm publish --registry http://localhost:4873"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "context-compression",
    "llm",
    "agent",
    "prompt-pruning",
    "modernbert",
    "asymmetric-loss",
    "token-savings",
    "milvus",
    "vector-memory",
    "headroom"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/peterlodri-sec/kompress-ultra.git"
  },
  "bugs": {
    "url": "https://github.com/peterlodri-sec/kompress-ultra/issues"
  },
  "homepage": "https://proposal.vaked.dev",
  "author": "Peter Lodri <peter@peterl.dev> (https://peterl.dev)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260629.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "agents": "^0.17.1",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  }
}
